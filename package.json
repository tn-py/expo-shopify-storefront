{
  "name": "expo-shopify-storefront",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Open-source Expo template for a native iOS + Android Shopify storefront: Storefront API browsing, authenticated Checkout Sheet Kit checkout, customer accounts, wishlist, deep links, analytics, crash reporting — with a mock.shop demo mode so it runs with zero Shopify credentials.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tn-py/expo-shopify-storefront.git"
  },
  "keywords": [
    "expo",
    "react-native",
    "shopify",
    "storefront-api",
    "ecommerce",
    "template",
    "checkout-sheet-kit",
    "shopify-checkout-kit",
    "expo-router",
    "push-notifications",
    "onesignal",
    "mock-shop",
    "sentry",
    "wishlist",
    "customer-account-api"
  ],
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/checkout-sheet-kit": "^3.9.0",
    "@shopify/storefront-api-client": "^2.0.0",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "heroui-native": "^1.0.10",
    "posthog-react-native": "^4.76.0",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.33.0",
    "react-native-onesignal": "^5.5.13",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "~1.20.4",
    "jest-expo": "~57.0.5",
    "onesignal-expo-plugin": "^2.7.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor@1.19.12",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "e2e": "echo 'Run: maestro test -e APP_ID=<your bundle id> .maestro/  (see docs/e2e.md)' && maestro test -e APP_ID=${APP_ID:-com.example.storefront} .maestro/"
  },
  "private": true
}
