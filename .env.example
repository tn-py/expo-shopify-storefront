# Copy to `.env` and fill in. Every EXPO_PUBLIC_* var is inlined into the JS
# bundle at build time (safe: the Storefront API token and Customer Account API
# client id are *public* credentials). `.env*` is gitignored except this file.
#
# After changing any value, restart Metro with a clear cache:
#   npx expo start --dev-client --clear
# Values that affect native config (APP_* identity, link domains) also require a
# new dev-client build: `eas build --profile development`.

# ─────────────────────────────────────────────────────────────────────────────
# Shopify Storefront API  (required — the app shows a setup screen without it)
# ─────────────────────────────────────────────────────────────────────────────
# Your permanent *.myshopify.com domain (NOT a custom domain).
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=example-store.myshopify.com
# Storefront API public access token.
# Shopify admin → Settings → Apps and sales channels → Develop apps → (your app)
#   → API credentials → "Storefront API access token".
# Required scopes: unauthenticated_read_product_listings,
#   unauthenticated_read_product_inventory, unauthenticated_read_product_tags,
#   unauthenticated_write_checkouts, unauthenticated_read_checkouts,
#   unauthenticated_read_content.  See docs/shopify-setup.md.
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Storefront + Customer Account API version to pin.
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-07

# ─────────────────────────────────────────────────────────────────────────────
# Shopify Customer Account API  (optional — sign-in / orders / addresses)
# Leave blank to ship the app without customer accounts.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# The shop-specific auth base URL, e.g. https://shopify.com/authentication/<shop-id>
# From the Headless / Customer Account API settings. The numeric <shop-id> is
# used to derive the required `shop.<shop-id>.app://` callback scheme.
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
# Full https URL for the hosted Shopify customer-account page where customers
# can add/edit addresses. The native Addresses screen intentionally stays view-only.
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_MANAGE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# App identity  (build-time — changing these needs a new native build)
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=Shopify Storefront
EXPO_PUBLIC_APP_SLUG=expo-shopify-storefront
# Custom URL scheme for deep links: <scheme>://product/<handle>
EXPO_PUBLIC_APP_SCHEME=shopstore
# iOS bundle identifier + Android package name (reverse-DNS, must be unique).
EXPO_PUBLIC_APP_BUNDLE_ID=com.example.storefront
# Comma-separated hosts for https universal / app links. Leave blank to skip.
# e.g. shop.example.com,www.example.com   (also host the files in docs/well-known/)
EXPO_PUBLIC_APP_UNIVERSAL_LINK_DOMAINS=

# ─────────────────────────────────────────────────────────────────────────────
# Branding
# ─────────────────────────────────────────────────────────────────────────────
# Primary accent (buttons, links, active tab, notification colour).
EXPO_PUBLIC_BRAND_PRIMARY=#0a7ea4
# Foreground colour used on top of the primary accent.
EXPO_PUBLIC_BRAND_ON_PRIMARY=#ffffff
# Sale / discounted price + cart badge.
EXPO_PUBLIC_BRAND_SALE=#d1453b
# Splash + Android adaptive-icon background.
EXPO_PUBLIC_APP_BACKGROUND=#ffffff
# light | dark | system   (default: system — follows the device and HeroUI/Uniwind)
EXPO_PUBLIC_APP_COLOR_SCHEME=system
# The Home screen shows the store's Shopify brand logo automatically when one is
# set (Shopify admin → Settings → Brand); otherwise it shows the store name.

# ─────────────────────────────────────────────────────────────────────────────
# Account screen links  (optional — invalid/blank links are hidden)
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_ABOUT_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Markets / localization  (optional — defaults to the device locale)
# Shopify's Storefront API can localize prices/content per shopper via
# @inContext(country, language) — see src/shopify/locale.ts. Leave blank to
# follow the device's own locale automatically.
# ─────────────────────────────────────────────────────────────────────────────
# ISO 3166-1 alpha-2 country override, e.g. GB, DE. Blank = device region.
EXPO_PUBLIC_SHOPIFY_COUNTRY=
# Two-letter uppercase Shopify LanguageCode override, e.g. EN, FR. Blank =
# device language.
EXPO_PUBLIC_SHOPIFY_LANGUAGE=
# device (default) — derive country/language as above | off — skip
# localization entirely (storefrontLocale is null; callers omit @inContext).
EXPO_PUBLIC_SHOPIFY_LOCALIZE=device

# ─────────────────────────────────────────────────────────────────────────────
# Analytics — PostHog  (optional — no-ops when blank)
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────────────────────────────────────
# Push notifications — OneSignal  (optional — no-ops when blank)
# Create an app at https://onesignal.com, add the iOS (APNs) + Android (FCM)
# platforms, then copy the App ID from Settings → Keys & IDs. Full walkthrough:
# docs/push-notifications.md. Setting this adds native code, so it needs a new
# dev-client build: `eas build --profile development`.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ONESIGNAL_APP_ID=
# iOS APNs environment baked into the build: development | production
# (development for dev-client / simulator, production for TestFlight / release).
EXPO_PUBLIC_ONESIGNAL_IOS_MODE=development

# ─────────────────────────────────────────────────────────────────────────────
# Crash reporting — Sentry  (optional — no-ops when blank)
# Create a project at https://sentry.io and copy its DSN. Adds the
# @sentry/react-native/expo config plugin, so it needs a new dev-client build:
# `eas build --profile development`. sendDefaultPii is always off — see
# src/lib/monitoring.ts.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
# Org/project slugs for source-map upload at build time (Sentry → Settings).
# Not EXPO_PUBLIC_ — only read by app.config.ts, never inlined into the bundle.
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry auth token for source-map upload. Set as an EAS secret
# (`eas secret:create --name SENTRY_AUTH_TOKEN`), never committed here.

# ─────────────────────────────────────────────────────────────────────────────
# Accelerated checkout — Shop Pay / Apple Pay wallet buttons
# (optional — off by default; iOS 16+ only). See docs/accelerated-checkout.md.
# ─────────────────────────────────────────────────────────────────────────────
# Set to "true" to enable. Requires the merchant to request the
# `write_cart_wallet_payments` scope from Shopify for this Storefront API app.
EXPO_PUBLIC_SHOPIFY_ACCELERATED_CHECKOUT=
# Apple merchant id from Shopify admin → Settings → Payments → Apple Pay,
# e.g. merchant.com.example.storefront. Apple Pay is offered only when this is
# set; Shop Pay is offered either way. Setting/changing this needs a new
# native build (adds the com.apple.developer.in-app-payments entitlement).
EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# EAS  (optional — `eas init` sets these; or paste them to pin the project)
# Not EXPO_PUBLIC_ — only read by app.config.ts during builds. EAS_PROJECT_ID
# also turns on OTA updates (`updates.url`); runtimeVersion always uses the
# `fingerprint` policy, so no manual version bump is needed. eas.json already
# maps each build profile to an update channel.
# ─────────────────────────────────────────────────────────────────────────────
EAS_PROJECT_ID=
EAS_OWNER=
